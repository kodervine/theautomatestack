# Copy this file to .env and fill in the secrets. .env is ignored by git, never commit it.

# Notion: create an integration at https://www.notion.so/profile/integrations,
# then share the "Blog Posts" database with it (... menu > Connections).
NOTION_TOKEN=
NOTION_DATABASE_ID=
# Optional. The sync finds this itself from the database ID, but you can pin it.
NOTION_DATA_SOURCE_ID=

# Gemini: only needed for npm run draft. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Change if Google retires this model name.
GEMINI_MODEL=gemini-2.5-flash
