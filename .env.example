# Copy this file to .env and fill in the secrets. .env is ignored by git, never commit it.

# Notion: create an integration at https://www.notion.so/profile/integrations,
# then share the "Blog Posts" database with it (... menu > Connections).
NOTION_TOKEN=
NOTION_DATABASE_ID=
# Optional. The sync finds this itself from the database ID, but you can pin it.
NOTION_DATA_SOURCE_ID=

# Gemini: only needed for npm run draft. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Change if Google retires this model name.
GEMINI_MODEL=gemini-2.5-flash

# AutoStack Quick Class (api/quickclass-register.js and api/quickclass-watched.js).
# Set these in Vercel too (Project > Settings > Environment Variables), then redeploy.
# Use the n8n Production URLs (/webhook/...). The /webhook-test/ URLs only work while the workflow is open in the editor.
# The site calls these from the server, so they never appear in the page.
# Registration: receives { name, email, classId, classTitle, watchUrl, offerUrl }
N8N_REGISTER_WEBHOOK_URL=
# Watched past the offer point: receives { email, classId, offerUrl, watchUrl }
N8N_WATCHED_WEBHOOK_URL=
